{
  "name": "vetcare-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Base frontend de VetCare Pro con HTML, Bootstrap y jQuery.",
  "scripts": {
    "format": "prettier --write \"{index.html,README.md,assets/**/*.{css,js,json},client/**/*.html,vet/**/*.html,admin/**/*.html,partials/**/*.html}\"",
    "format:check": "prettier --check \"{index.html,README.md,assets/**/*.{css,js,json},client/**/*.html,vet/**/*.html,admin/**/*.html,partials/**/*.html}\"",
    "lint:js": "eslint assets/js",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint:html": "html-validate index.html client/**/*.html vet/**/*.html admin/**/*.html",
    "check": "npm run format:check && npm run lint:js && npm run lint:css && npm run lint:html"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "eslint": "9.31.0",
    "globals": "16.3.0",
    "html-validate": "10.7.0",
    "prettier": "3.6.2",
    "stylelint": "16.24.0",
    "stylelint-config-standard": "38.0.0"
  }
}
